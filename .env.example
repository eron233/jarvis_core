JARVIS_ENV=production
JARVIS_TOKEN=defina_um_token_seguro
JARVIS_TRUSTED_DEVICE_ID=eron-celular-principal
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000
JARVIS_LOOP_INTERVAL_SECONDS=5
JARVIS_IDLE_SLEEP_SECONDS=10
JARVIS_LOG_LEVEL=INFO
JARVIS_ENABLE_RUNTIME_LOOP=true
JARVIS_ENABLE_DASHBOARD=true
JARVIS_SIMPLE_WEB_LOGIN=false
JARVIS_DATA_DIR=/app/data
JARVIS_LOGS_DIR=/app/logs
JARVIS_REPORTS_DIR=/app/reports
JARVIS_QUEUE_STORAGE_PATH=/app/data/task_queue_store.json
JARVIS_SEMANTIC_STORAGE_PATH=/app/data/semantic_memory_store.json
JARVIS_EPISODIC_STORAGE_PATH=/app/data/episodic_memory_store.json
JARVIS_PROCEDURAL_STORAGE_PATH=/app/data/procedural_memory_store.json
JARVIS_GOALS_STORAGE_PATH=/app/data/goals.json
JARVIS_DEVICE_REGISTRY_PATH=/app/data/device_registry.json
JARVIS_COGNITIVE_EVOLUTION_STORAGE_PATH=/app/data/cognitive_evolution_history.json
JARVIS_AUDIT_STORAGE_PATH=/app/data/runtime_audit_store.json
JARVIS_SELF_DEFENSE_REPORT_PATH=/app/reports/self_defense_latest.json
JARVIS_ADMIN_VOICE=eron
JARVIS_ADMIN_PASSWORD=
JARVIS_CLIENT_URL=http://localhost:8000/api/comando
JARVIS_SERVICE_PYTHON=C:\Program Files\PostgreSQL\17\pgAdmin 4\python\python.exe

# Memoria avancada opcional: Qdrant + Qwen3 + Mem0 OSS
# Instale requirements-memory.txt antes de ativar.
JARVIS_ADVANCED_MEMORY_ENABLED=false
JARVIS_QDRANT_PATH=/app/data/qdrant
JARVIS_QDRANT_URL=
JARVIS_QDRANT_API_KEY=
JARVIS_QDRANT_COLLECTION=jarvis_semantic_memory
JARVIS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
JARVIS_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
JARVIS_VECTOR_TOP_K=20
JARVIS_MEM0_ENABLED=false
JARVIS_MEM0_USER_ID=jarvis-owner
JARVIS_OLLAMA_BASE_URL=http://localhost:11434
JARVIS_MEM0_LLM_MODEL=qwen3:4b
