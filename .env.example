JARVIS_ENV=production
JARVIS_TOKEN=defina_um_token_seguro
JARVIS_TRUSTED_DEVICE_ID=eron-celular-principal
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000
JARVIS_LOOP_INTERVAL_SECONDS=5
JARVIS_IDLE_SLEEP_SECONDS=10
JARVIS_LOG_LEVEL=INFO
JARVIS_ENABLE_RUNTIME_LOOP=true
JARVIS_ENABLE_DASHBOARD=true
JARVIS_SIMPLE_WEB_LOGIN=false
JARVIS_DATA_DIR=/app/data
JARVIS_LOGS_DIR=/app/logs
JARVIS_REPORTS_DIR=/app/reports
JARVIS_QUEUE_STORAGE_PATH=/app/data/task_queue_store.json
JARVIS_SEMANTIC_STORAGE_PATH=/app/data/semantic_memory_store.json
JARVIS_EPISODIC_STORAGE_PATH=/app/data/episodic_memory_store.json
JARVIS_PROCEDURAL_STORAGE_PATH=/app/data/procedural_memory_store.json
JARVIS_GOALS_STORAGE_PATH=/app/data/goals.json
JARVIS_DEVICE_REGISTRY_PATH=/app/data/device_registry.json
JARVIS_COGNITIVE_EVOLUTION_STORAGE_PATH=/app/data/cognitive_evolution_history.json
JARVIS_AUDIT_STORAGE_PATH=/app/data/runtime_audit_store.json
JARVIS_SELF_DEFENSE_REPORT_PATH=/app/reports/self_defense_latest.json
JARVIS_ADMIN_VOICE=eron
JARVIS_ADMIN_PASSWORD=
JARVIS_CLIENT_URL=http://localhost:8000/api/comando
JARVIS_SERVICE_PYTHON=C:\Program Files\PostgreSQL\17\pgAdmin 4\python\python.exe

# Memoria avancada opcional: Qdrant + Qwen3 + Mem0 OSS
# ATENCAO: estes Qwen3 sao componentes especializados da memoria, nao o
# modelo-base do JARVIS. Nao remover por causa de JARVIS_MODEL_* estar vazio.
# Substituicao somente apos benchmark + regressao da memoria.
# Instale requirements-memory.txt antes de ativar.
JARVIS_ADVANCED_MEMORY_ENABLED=false
JARVIS_QDRANT_PATH=/app/data/qdrant
JARVIS_QDRANT_URL=
JARVIS_QDRANT_API_KEY=
JARVIS_QDRANT_COLLECTION=jarvis_semantic_memory
JARVIS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
JARVIS_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
JARVIS_VECTOR_TOP_K=20
JARVIS_MEM0_ENABLED=false
JARVIS_MEM0_USER_ID=jarvis-owner
JARVIS_OLLAMA_BASE_URL=http://localhost:11434
JARVIS_MEM0_LLM_MODEL=qwen3:4b

# Voz local avancada (ponto 2)
# Instale requirements-voice.txt e configure os modelos locais antes de ativar.
JARVIS_VOICE_ADVANCED_ENABLED=false
JARVIS_VOICE_LOCALE=pt-BR

# STT: faster-whisper + Silero VAD integrado
JARVIS_STT_BACKEND=faster-whisper
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_STT_CPU_THREADS=0
JARVIS_STT_BEAM_SIZE=5
JARVIS_STT_LANGUAGE=pt
JARVIS_STT_VAD_FILTER=true
JARVIS_STT_VAD_MIN_SILENCE_MS=500
JARVIS_VOICE_ALLOW_MODEL_DOWNLOAD=false

# TTS leve: Kokoro ONNX pt-BR
JARVIS_TTS_BACKEND=kokoro-onnx
JARVIS_TTS_VOICE=pm_alex
JARVIS_TTS_SPEED=1.0
JARVIS_KOKORO_MODEL_PATH=
JARVIS_KOKORO_VOICES_PATH=

# Wake word real via openWakeWord (modelo local)
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_WAKE_WORD_MODEL_PATH=
JARVIS_WAKE_WORD_THRESHOLD=0.5
JARVIS_WAKE_WORD_VAD_THRESHOLD=0.5

# Enhancement opcional via DeepFilterNet Python ou CLI isolado
JARVIS_AUDIO_ENHANCEMENT_ENABLED=false
JARVIS_DEEPFILTER_MODEL=
JARVIS_DEEPFILTER_COMMAND=

# Visao/OCR avancada (ponto 3)
# Instale requirements-vision.txt antes de ativar.
JARVIS_VISION_ADVANCED_ENABLED=false
JARVIS_VISION_LOCALE=pt-BR

# OCR leve PP-OCRv6. Small e o padrao equilibrado; tiny reduz ainda mais custo.
JARVIS_OCR_BACKEND=paddleocr-v6
JARVIS_OCR_DEVICE=cpu
JARVIS_OCR_ENGINE=paddle_static
JARVIS_OCR_DETECTION_MODEL=PP-OCRv6_small_det
JARVIS_OCR_RECOGNITION_MODEL=PP-OCRv6_small_rec
JARVIS_OCR_DETECTION_MODEL_DIR=
JARVIS_OCR_RECOGNITION_MODEL_DIR=
JARVIS_OCR_ALLOW_MODEL_DOWNLOAD=false
JARVIS_OCR_MIN_SCORE=0.35

# Document vision pesado/sob demanda (PaddleOCR-VL)
JARVIS_DOCUMENT_VL_ENABLED=false
JARVIS_DOCUMENT_VL_DEVICE=cpu
JARVIS_DOCUMENT_VL_ENGINE=transformers
JARVIS_DOCUMENT_VL_ALLOW_MODEL_DOWNLOAD=false

# Visao geral via Moondream Station/local endpoint
JARVIS_GENERAL_VISION_ENABLED=false
JARVIS_GENERAL_VISION_ENDPOINT=http://localhost:2020/v1
JARVIS_GENERAL_VISION_MODEL=

# Documentos/ingestao estruturada (ponto 4)
# Instale requirements-documents.txt antes de ativar Docling.
JARVIS_DOCUMENT_PARSER_ENABLED=false
JARVIS_DOCUMENT_PARSER_BACKEND=docling
JARVIS_DOCUMENT_DEVICE=cpu

# Para PDF offline, pre-provisione os modelos Docling e informe o diretorio.
JARVIS_DOCLING_ARTIFACTS_PATH=
JARVIS_DOCLING_ALLOW_MODEL_DOWNLOAD=false
JARVIS_DOCLING_PDF_OCR=true
JARVIS_DOCLING_PDF_TABLES=true
JARVIS_DOCLING_ENABLE_REMOTE_SERVICES=false

# Preservacao/chunking do conteudo integral
JARVIS_DOCUMENT_MAX_OUTPUT_CHARS=2000000
JARVIS_DOCUMENT_CHUNK_CHARS=4000
JARVIS_DOCUMENT_CHUNK_OVERLAP_CHARS=400

# Web/Pesquisa/Navegação (ponto 5)
JARVIS_WEB_ADVANCED_ENABLED=false

# SearXNG self-hosted. Ex.: http://127.0.0.1:8080
JARVIS_SEARXNG_URL=
JARVIS_SEARXNG_LANGUAGE=pt-BR
JARVIS_SEARXNG_SAFESEARCH=1
JARVIS_WEB_SEARCH_TIMEOUT_SECONDS=10

# Crawl4AI 0.9.4+ (crawler/Markdown real)
JARVIS_CRAWL4AI_ENABLED=false
JARVIS_CRAWL4AI_BROWSER=chromium
JARVIS_CRAWL4AI_HEADLESS=true
JARVIS_CRAWL4AI_TIMEOUT_MS=20000

# Playwright determinístico para páginas JavaScript
JARVIS_PLAYWRIGHT_ENABLED=false
JARVIS_PLAYWRIGHT_BROWSER=chromium
JARVIS_PLAYWRIGHT_HEADLESS=true
JARVIS_PLAYWRIGHT_TIMEOUT_MS=20000

# Fallback HTTP real e limites
JARVIS_SIMPLE_HTTP_ENABLED=true
JARVIS_WEB_ALLOW_PRIVATE_TARGETS=false
JARVIS_WEB_MAX_HTTP_BYTES=5242880
JARVIS_WEB_MAX_CONTENT_CHARS=100000
JARVIS_WEB_USER_AGENT=JarvisResearchEngine/2.0

# Inferencia local / runtime de modelos (ponto 6)
# Nenhum modelo e escolhido por padrao. Preencha aliases somente apos benchmark local.
JARVIS_INFERENCE_ENABLED=false
JARVIS_INFERENCE_PROVIDER_ORDER=llamacpp,ollama

# llama.cpp server OpenAI-compatible
JARVIS_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
JARVIS_LLAMACPP_API_KEY=

# Ollama local OpenAI-compatible
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
JARVIS_OLLAMA_API_KEY=

# Por seguranca, endpoints de inferencia remotos ficam bloqueados.
JARVIS_INFERENCE_ALLOW_REMOTE_ENDPOINTS=false
JARVIS_INFERENCE_TIMEOUT_SECONDS=120
JARVIS_INFERENCE_MAX_TOKENS=1024
JARVIS_INFERENCE_TEMPERATURE=0.2

# Aliases de modelos: manter vazios ate o benchmark no hardware alvo.
JARVIS_MODEL_LIGHT=
JARVIS_MODEL_HEAVY=
JARVIS_MODEL_GENERAL=
JARVIS_MODEL_CODING=
JARVIS_MODEL_REASONING=

# MCP oficial (ponto 7)
# Instale requirements-mcp.txt para ativar cliente/servidor MCP v2.
JARVIS_MCP_ENABLED=false
JARVIS_MCP_REGISTRY_PATH=data/mcp_servers.json
JARVIS_MCP_ALLOW_REMOTE_HTTP=false
JARVIS_MCP_ALLOWED_STDIO_COMMANDS=python,python3,uv,uvx
JARVIS_MCP_MAX_RESULT_CHARS=200000

# Servidor MCP read-only do próprio JARVIS
JARVIS_MCP_SERVER_TRANSPORT=stdio
JARVIS_MCP_SERVER_HOST=127.0.0.1
JARVIS_MCP_SERVER_ALLOW_REMOTE_BIND=false
JARVIS_MCP_SERVER_PORT=8765
JARVIS_MCP_SERVER_PATH=/mcp

# Inteligencia estrutural do proprio codigo (ponto 8)
# Fallback AST Python local e leve permanece ativo por padrao.
JARVIS_CODEBASE_AST_ENABLED=true
JARVIS_CODEBASE_DB_PATH=data/codebase_intelligence.sqlite3
JARVIS_CODEBASE_MAX_FILES=5000
JARVIS_CODEBASE_MAX_FILE_BYTES=1500000

# Backend preferido codebase-memory-mcp via MCP oficial.
# Exige servidor cadastrado em data/mcp_servers.json e command explicitamente
# autorizado em JARVIS_MCP_ALLOWED_STDIO_COMMANDS.
JARVIS_CODEBASE_MCP_ENABLED=false
JARVIS_CODEBASE_MCP_SERVER=codebase-memory
JARVIS_CODEBASE_MCP_PROJECT=jarvis_core
JARVIS_CODEBASE_MCP_AUTO_INDEX=false

# Governanca de contexto para agentes de desenvolvimento (ponto 9)
JARVIS_DEV_CONTEXT_LOCAL_ENABLED=true
JARVIS_DEV_CONTEXT_MAX_FULL_LINES=150
JARVIS_DEV_CONTEXT_MAX_FULL_BYTES=12288
JARVIS_DEV_CONTEXT_EARLY_BYTES=20480
JARVIS_DEV_CONTEXT_MID_BYTES=10240
JARVIS_DEV_CONTEXT_LATE_BYTES=4096
JARVIS_DEV_CONTEXT_MAX_RANGE_LINES=250
JARVIS_DEV_CONTEXT_PREFER_EXTERNAL=true

# flyingrobots/graft v0.14.0 via MCP oficial. Desativado ate provisionamento.
JARVIS_GRAFT_CONTEXT_ENABLED=false
JARVIS_GRAFT_CONTEXT_SERVER=graft-context

# Ao ativar Graft instalado no PATH, acrescente 'graft' explicitamente:
# JARVIS_MCP_ALLOWED_STDIO_COMMANDS=python,python3,uv,uvx,codebase-memory-mcp,graft


# Cache semantico real (ponto 10)
# Nenhum modelo e selecionado por padrao. O cache exato funciona sem modelo.
# Para ativar similaridade vetorial no futuro, o proprietario deve escolher
# explicitamente um modelo de embedding e instalar requirements-memory.txt.
JARVIS_SEMANTIC_CACHE_VECTOR_ENABLED=false
JARVIS_SEMANTIC_CACHE_EMBEDDING_MODEL=
JARVIS_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
JARVIS_SEMANTIC_CACHE_VECTOR_TOP_K=3
JARVIS_SEMANTIC_CACHE_QDRANT_URL=
JARVIS_SEMANTIC_CACHE_QDRANT_API_KEY=
JARVIS_SEMANTIC_CACHE_QDRANT_PATH=/app/data/qdrant_semantic_cache
JARVIS_SEMANTIC_CACHE_QDRANT_COLLECTION=jarvis_semantic_cache
